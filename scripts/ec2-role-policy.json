{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListProfileBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::lab6-usuarios-304318513298-us-east-1"
    },
    {
      "Sid": "ManageProfileImages",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::lab6-usuarios-304318513298-us-east-1/profiles/*"
    },
    {
      "Sid": "ReadLabParameters",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:us-east-1:304318513298:parameter/lab6/*"
    }
  ]
}
